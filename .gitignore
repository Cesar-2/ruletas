# Dependencias
node_modules/

# Salida de TypeScript
dist/

# Datos de cada instalación. Se ignora todo salvo exclusiones y rarezas, que
# se versionan vacias como plantilla. Nota: hay que usar "data/*" y no "data/",
# porque Git no entra en un directorio ignorado y las excepciones no aplicarian.
data/*
!data/exclusions.json
!data/tags.json

# Fondos subidos desde el panel de configuracion: son de cada instalacion.
public/assets/fondo-*

# Volcados de pruebas de la API
api_raw.json
last_items.json
rand.json

# Entorno
.env
.env.local

# Sistema operativo
Thumbs.db
Desktop.ini
.DS_Store

# Logs
*.log
npm-debug.log*
