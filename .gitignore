# Dependencias
node_modules/

# Salida de TypeScript
dist/

# Datos de cada instalación: no salen del equipo y no se versiona ninguno, ni
# siquiera vacio como plantilla. El servidor crea lo que falte al arrancar:
# sin exclusiones, sin rarezas y sin ganadores.
data/

# Fondos subidos desde el panel de configuracion: son de cada instalacion.
public/assets/fondo-*

# Volcados de pruebas de la API
api_raw.json
last_items.json
rand.json

# Entorno
.env
.env.local

# Sistema operativo
Thumbs.db
Desktop.ini
.DS_Store

# Logs
*.log
npm-debug.log*
