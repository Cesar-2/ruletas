# Dependencias
node_modules/

# Salida de TypeScript
dist/

# Datos de cada instalación: no salen del equipo. Las exclusiones son de quien
# usa la app, asi que tampoco se versionan vacias; si el archivo no existe, el
# servidor arranca sin ninguna exclusion. Nota: hay que usar "data/*" y no
# "data/", porque Git no entra en un directorio ignorado y las excepciones no
# aplicarian.
data/*
!data/tags.json

# Fondos subidos desde el panel de configuracion: son de cada instalacion.
public/assets/fondo-*

# Volcados de pruebas de la API
api_raw.json
last_items.json
rand.json

# Entorno
.env
.env.local

# Sistema operativo
Thumbs.db
Desktop.ini
.DS_Store

# Logs
*.log
npm-debug.log*
